# Copy this file to `keystore.properties` (which is gitignored)
# and fill in your own keystore details to build a signed release APK.
#
# Generate a personal keystore with:
#   keytool -genkeypair -keystore bankmail-release.jks -storetype PKCS12 \
#     -alias bankmail -keyalg RSA -sigalg SHA256withRSA -keysize 2048 -validity 10000

storeFile=bankmail-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=bankmail
keyPassword=CHANGE_ME_KEY_PASSWORD
